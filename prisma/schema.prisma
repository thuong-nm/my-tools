// Storage model. This is NOT the domain model (AGENTS.md rule 5): it is shaped by
// what Postgres stores well, while the domain is shaped by invariants. The two are
// bridged by mappers in lib/infrastructure/prisma/mappers/.
//
// Two conventions to keep when adding models:
//   - Money is `Int`, in the currency's smallest whole unit. Never Float (binary
//     rounding), never Decimal unless the currency actually has a minor unit.
//   - Every timestamp is `@db.Timestamptz(6)`. `timestamp without time zone`
//     silently drops the offset, and that mistake surfaces as a wrong-day bug.

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 convention).
}

/// Mirrors lib/domain/value-objects/content-format.ts. The editor's "Auto Detect" resolves to
/// one of these in the browser, so it is never stored.
enum ContentFormat {
  PLAIN
  MARKDOWN
  JSON
  XML
  HTML
  HTML_RENDER
}

model User {
  id String @id @db.Uuid

  /// Stored already normalised by the domain's Email value object, so this unique index is
  /// case-correct without a functional index or a citext column.
  email String @unique

  /// Opaque, self-describing: `scrypt$N$r$p$salt$key`. Never a plaintext password.
  passwordHash String

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  shares         TextShare[]
  passwordResets PasswordReset[]
}

model TextShare {
  id String @id @db.Uuid

  /// The public half of a share link. Unique because the INSERT is the lock: a
  /// check-then-act would let two callers claim the same code at READ COMMITTED.
  code String @unique

  /// Compressed and URL-safe already — the browser owns the codec, so this is opaque here.
  content String
  format  ContentFormat

  /// Nullable: a share saved without signing in stays anonymous and belongs to no history.
  /// Cascades because a share is personal content — closing an account takes it along.
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  views TextShareView[]

  /// For the purge job that reclaims expired rows.
  @@index([expiresAt])
  /// Serves history's "this owner's rows, newest first" in one index scan.
  @@index([ownerId, createdAt])
}

/// A password reset link, stored so it can be single-use: the emailed link outlives the reset
/// otherwise, and mailboxes forward and archive.
model PasswordReset {
  /// SHA-256 of the emailed token. The plaintext is never stored, so reading this table does
  /// not hand out working reset links.
  tokenHash String @id

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @db.Timestamptz(6)
  /// NULL means pending. Set once, on the reset that consumes it.
  usedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  /// Serves "retire this account's outstanding links" when a new one is requested.
  @@index([userId])
}

/// One row per distinct viewer of a share. The owner's own views are never recorded, so the
/// count means "other people", which is the only reading that is useful to the owner.
model TextShareView {
  shareId String    @db.Uuid
  share   TextShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  /// sha256(secret + code + ip + user-agent). The raw IP is never stored, and the per-code
  /// salt means the same visitor is not linkable across two different shares.
  viewerHash String

  firstSeenAt DateTime @default(now()) @db.Timestamptz(6)

  /// The composite primary key IS the dedup lock: a second view inserts nothing.
  @@id([shareId, viewerHash])
}
