APP_URL=http://localhost:3000

DATABASE_URL=postgresql://app:app@postgres:5432/app?schema=public

TZ=Asia/Ho_Chi_Minh

CORS_ALLOWED_ORIGINS=

# Local development only. A deployment supplies its own, from its environment.
SESSION_SECRET=dev-only-session-secret-change-me-in-deployment

# reCAPTCHA v3, a GROUP: both blank turns bot checking off, filling in only one half fails at
# startup. Both are left blank HERE on purpose — Next skips .env.local when NODE_ENV=test, so a
# site key committed here with the secret in .env.local would be a half-filled group under test.
# Put BOTH in .env.local (gitignored), or in the deployment's environment.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
